# BeamMP Server Configurator Example Environment Variables

# --- Core Server Settings ---
SECRET_KEY=your_secret_key_here

# --- Gunicorn Settings ---
# Number of worker processes (default: 1)
GUNICORN_WORKERS=1
# Bind address (default: 0.0.0.0:5000)
GUNICORN_BIND=0.0.0.0:5000
# Access log file (default: - for stdout)
GUNICORN_ACCESS_LOG=-

# --- Authentication Mode ---
# Options: NO_AUTH, BASIC, SAML, OAUTH
AUTH_MODE=BASIC

# --- BASIC Auth (default) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here

# --- SAML Auth (for SSO/Enterprise) ---
# Only required if AUTH_MODE=SAML
SAML_IDP_METADATA_URL=https://your-idp.com/metadata
SAML_SP_ENTITY_ID=http://localhost:5000/saml/metadata
SAML_SP_ACS_URL=http://localhost:5000/saml/acs
# Optional: SAML_SP_CERT and SAML_SP_KEY for signed requests
# SAML_SP_CERT=/path/to/sp-cert.pem
# SAML_SP_KEY=/path/to/sp-key.pem

# --- OAuth2/OIDC Auth (for SSO/Enterprise) ---
# Only required if AUTH_MODE=OAUTH
OAUTH_CLIENT_ID=your_oauth_client_id
OAUTH_CLIENT_SECRET=your_oauth_client_secret
OAUTH_AUTHORIZE_URL=https://your-oauth-provider.com/authorize
OAUTH_TOKEN_URL=https://your-oauth-provider.com/token
OAUTH_USERINFO_URL=https://your-oauth-provider.com/userinfo
OAUTH_SCOPE=openid email profile
OAUTH_REDIRECT_URI=http://localhost:5000/oauth/callback
OAUTH_PROVIDER=authentik
# OIDC_DISCOVERY_URL=https://your-oauth-provider.com/.well-known/openid-configuration
# OIDC_JWKS_URL=https://your-oauth-provider.com/.well-known/jwks.json

# --- Server/Config/Backup Directories ---
CONFIG_DIR=/config
BACKUP_DIR=/backup
SERVER_DIR=/server

# --- Docker Proxy (for server management features) ---
DOCKER_HOST=http://docker-proxy:2375
BEAMMP_CONTAINER_NAME=beammp-server

# --- Other (optional) ---
# Set log level, debug, etc. as needed
# LOG_LEVEL=info 